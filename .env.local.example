# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (Project Settings -> API -> service_role). Server-only,
# bypasses Row Level Security - never expose to the client. Used by the
# Stripe webhook handler, which has no end-user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build email-confirmation redirect links and Stripe
# success/cancel/return URLs in local/dev/prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Dashboard -> Developers -> API keys). Use test-mode keys locally.
STRIPE_SECRET_KEY=sk_test_...
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# For local development use the Stripe CLI: `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring Price IDs for the paid Vereins-Abo tiers (Dashboard -> Product
# catalog). The free Starter tier needs no price.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ALLIN=price_...
